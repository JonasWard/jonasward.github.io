---
// dev-only pages: getStaticPaths returns nothing in a production build, so they never end up in build/
import 'src/components/cv/cv.css';
import 'src/components/motivationLetter/motivationletter.css';
import '../styles/motivation-letter.css';
import Base from '../layouts/Base.astro';
import logo from 'src/assets/jonasward_logo_elong.png?url';
import { CVContent } from 'src/components/cv/content/cvContent';
import { MotivationLetterDefaultContent } from 'src/components/motivationLetter/motivationLetterDefaultContent';

export const getStaticPaths = () => (import.meta.env.DEV ? [{ params: { devPage: 'create-motivation-letter' } }] : []);

const { info } = CVContent;
const fields = [
  ['title', 'Title'],
  ['intro', 'Intro'],
  ['people', 'People to Address'],
  ['content', 'Content'],
  ['outro', 'Outro'],
  ['wishes', 'Salutations'],
  ['city', 'City']
] as const;
---

<Base title="Motivation letter | Jonas Ward">
  <div class="cv-content">
    <div id="select" class="ml-toolbar">
      <select data-ml-key-select></select>
      <input data-ml-key-name placeholder="Title" />
      <button data-ml-print>download</button>
    </div>
    <form id="myDrawer" class="drawer" data-ml-form>
      {
        fields.map(([name, label]) => (
          <label>
            {label}
            {name === 'content' ? <textarea name={name} /> : <input type="text" name={name} />}
          </label>
        ))
      }
      <button type="button" data-ml-drawer>Open Input Drawer</button>
    </form>
    <article class="ml-letter" data-ml-letter>
      <div class="ml-head">
        <div class="ml-sender">
          <div>{info.firstName.split(' ')[0]}, {info.name}</div>
          <div class="ml-space"></div>
          <div>{info.addressLine1}</div>
          <div>{info.telephone}</div>
          <div>{info.email}</div>
          <a href="https://jonasward.ch/#/cv">jonasward.ch/#/cv</a>
        </div>
        <img src={logo} alt="" class="ml-logo" />
      </div>
      <div class="ml-title" data-ml="title"></div>
      <div class="ml-rule"></div>
      <div class="ml-body">
        <div class="ml-intro" data-ml="intro"></div>
        <div data-ml="people"></div>
        <div data-ml="content"></div>
        <div class="ml-space"></div>
        <div data-ml="outro"></div>
        <div data-ml="wishes"></div>
        <div>{info.firstName.split(' ')[0]} {info.name}</div>
        <div class="ml-space"></div>
        <div data-ml="date"></div>
      </div>
    </article>
  </div>
</Base>

<script is:inline define:vars={{ defaults: MotivationLetterDefaultContent }}>
  window.__ML_DEFAULTS__ = defaults;
</script>
<script>
  import '../scripts/motivationLetter';
</script>
