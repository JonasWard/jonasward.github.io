---
import Base from '../layouts/Base.astro';
import 'src/styles/pages/cv-print.css';
import { CVContent } from 'src/components/cv/content/cvContentCompact';
import { renderCV } from 'src/render/cv';
import profileImage from 'src/assets/pictures/jonas-icon.jpg?url';
import logo from 'src/assets/jonasward_logo_elong.png?url';
import printer from 'src/assets/icons/printer.svg?url';
import qrCode from 'src/assets/cv.png?url';

const createdOn = new Date();
const pdfName = `Van_den_Bulcke_Jonas${CVContent.cvName}-${createdOn.getFullYear()}-${createdOn.getMonth() + 1}-${createdOn.getDate()}.pdf`;
---

<Base title="CV | Jonas Ward">
  <Fragment
    set:html={renderCV(CVContent, {
      assets: { profileImage, logo, printer, qrCode },
      route: '/cv',
      // written by scripts/buildPdfs.mjs after the build
      pdfHref: '/cv/cv.pdf',
      pdfName,
      createdOn
    })}
  />
</Base>
