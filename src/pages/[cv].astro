---
// one page per cv variant at its old route (/cv/, /cv-max/, ...), each with its own qr code and pre-built pdf
import Base from '../layouts/Base.astro';
import 'src/styles/pages/cv-print.css';
import { CVContent as compact } from 'src/data/cv/cvContentCompact';
import { CVContent as max } from 'src/data/cv/cvContentMax';
import { CVContent as productDesigner } from 'src/data/cv/cvContentProductDesigner';
import { CVContent as livingLabHil } from 'src/data/cv/cvContentLivingLabHil';
import { renderCV } from 'src/render/cv';
import profileImage from 'src/assets/pictures/jonas-icon.jpg?url';
import logo from 'src/assets/jonasward_logo_elong.png?url';
import printer from 'src/assets/icons/printer.svg?url';
import qrCv from 'src/assets/cv.png?url';
import qrCvLonger from 'src/assets/cv-longer.png?url';
import qrCvMax from 'src/assets/cv-max.png?url';
import qrCvProductDesigner from 'src/assets/cv-product-designer.png?url';
import qrCvLivingLabHil from 'src/assets/cv-living-lab-hil.png?url';

export const getStaticPaths = () =>
  [
    { cv: 'cv', data: compact, qrCode: qrCv },
    { cv: 'cv-longer', data: max, qrCode: qrCvLonger },
    { cv: 'cv-max', data: max, qrCode: qrCvMax },
    { cv: 'cv-product-designer', data: productDesigner, qrCode: qrCvProductDesigner },
    { cv: 'cv-living-lab-hil', data: livingLabHil, qrCode: qrCvLivingLabHil }
  ].map(({ cv, ...props }) => ({ params: { cv }, props }));

const { cv } = Astro.params;
const { data, qrCode } = Astro.props;
const createdOn = new Date();
const pdfName = `Van_den_Bulcke_Jonas${data.cvName}-${createdOn.getFullYear()}-${createdOn.getMonth() + 1}-${createdOn.getDate()}.pdf`;
---

<Base title="CV | Jonas Ward">
  <Fragment
    set:html={renderCV(data, {
      assets: { profileImage, logo, printer, qrCode },
      route: `/${cv}`,
      // written by scripts/buildPdfs.mjs after the build
      pdfHref: `/${cv}/${cv}.pdf`,
      pdfName,
      createdOn
    })}
  />
</Base>
